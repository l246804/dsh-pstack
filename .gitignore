node_modules
dist
.audit
*.log
.DS_Store
# Build output of pstack/scripts/build-runtime.ts, consumed by the generator.
#
# It is a build directory, not a source tree. The directory sits under `.build/` rather than
# at the top level so its name cannot collide with a source directory, which an older layout
# got wrong once.
/.build
# The generated port tree. Rebuilt from pstack/runtime/, pstack/docs/, and the pinned
# submodule on every build, and shipped inside dist/. Ignoring it keeps an upstream sync's
# diff to the files a person actually wrote.
/pstack/pstack
# Scratch space for local verification; never part of the package.
.tmp
