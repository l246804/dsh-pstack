{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vite-plus/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "runner/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "scenarios/**/*.ts",
    "config.example.ts"
  ],
  "exclude": ["node_modules", ".workers", ".workers-*"]
}
