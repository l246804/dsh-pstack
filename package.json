{
  "name": "dsh-pstack",
  "version": "0.2.0-beta.1",
  "description": "pstack for DeepSeek Harness: rigorous agent workflows ported from cursor/plugins.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/dsh-pstack.git"
  },
  "homepage": "https://github.com/l246804/dsh-pstack#readme",
  "bugs": {
    "url": "https://github.com/l246804/dsh-pstack/issues"
  },
  "keywords": [
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "poteto-mode",
    "pstack",
    "workflow"
  ],
  "author": {
    "name": "leiwang",
    "email": "leiwang2000@foxmail.com"
  },
  "license": "MIT",
  "type": "module",
  "icon": "./static/icon.png",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./subagent": {
      "types": "./dist/subagent.d.mts",
      "default": "./dist/subagent.mjs"
    },
    "./history": {
      "types": "./dist/history.d.mts",
      "default": "./dist/history.mjs"
    },
    "./script": {
      "types": "./dist/script.d.mts",
      "default": "./dist/script.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./static/icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "static",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "catalog:inlined"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "catalog:testing",
    "@deepseek-ai/cordis-plugin-loader": "catalog:testing",
    "@deepseek-ai/dsh-agent": "catalog:types",
    "@deepseek-ai/dsh-jobs": "catalog:types",
    "@deepseek-ai/dsh-llm": "catalog:types",
    "@deepseek-ai/dsh-session": "catalog:types",
    "@deepseek-ai/dsh-session-query": "catalog:types",
    "@deepseek-ai/dsh-skill": "catalog:types",
    "@deepseek-ai/dsh-subagent": "catalog:types",
    "@deepseek-ai/dsh-system-prompt": "catalog:types",
    "@deepseek-ai/dsh-tools": "catalog:types",
    "@deepseek-ai/dsh-working-directory": "catalog:types",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "js-yaml": "catalog:testing",
    "typescript": "catalog:cli",
    "vite-plus": "catalog:cli"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0",
    "dsh": "0.2.1-rc.3"
  }
}
