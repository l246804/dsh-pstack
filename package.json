{
  "name": "dsh-pstack",
  "version": "0.1.0",
  "description": "pstack for DeepSeek Harness: rigorous agent workflows ported from cursor/plugins.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/dsh-pstack.git"
  },
  "homepage": "https://github.com/l246804/dsh-pstack#readme",
  "bugs": {
    "url": "https://github.com/l246804/dsh-pstack/issues"
  },
  "keywords": [
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "poteto-mode",
    "pstack",
    "workflow"
  ],
  "author": {
    "name": "leiwang",
    "email": "leiwang2000@foxmail.com"
  },
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./subagent": {
      "types": "./dist/subagent.d.mts",
      "default": "./dist/subagent.mjs"
    },
    "./history": {
      "types": "./dist/history.d.mts",
      "default": "./dist/history.mjs"
    },
    "./script": {
      "types": "./dist/script.d.mts",
      "default": "./dist/script.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "sync": "node scripts/sync-upstream.ts",
    "sync:check": "node scripts/sync-upstream.ts --check",
    "check:upstream": "node scripts/check-upstream-tree.mjs",
    "check:assets": "node scripts/check-assets.ts",
    "check:scripts": "node scripts/check-scripts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "check": "pnpm run check:upstream && pnpm run sync:check && pnpm run check:assets && pnpm run typecheck && pnpm run test && pnpm run build",
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.3"
  }
}
