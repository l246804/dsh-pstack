{
  "name": "dsh-pstack",
  "version": "0.3.1",
  "description": "pstack for DeepSeek Harness: rigorous agent workflows ported from cursor/plugins.",
  "keywords": [
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "poteto-mode",
    "pstack",
    "workflow"
  ],
  "homepage": "https://github.com/l246804/dsh-pstack#readme",
  "bugs": {
    "url": "https://github.com/l246804/dsh-pstack/issues"
  },
  "license": "MIT",
  "author": {
    "name": "leiwang",
    "email": "leiwang2000@foxmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/dsh-pstack.git"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./budget": "./dist/budget.mjs",
    "./catalogue": "./dist/catalogue.mjs",
    "./models": "./dist/models.mjs",
    "./paths": "./dist/paths.mjs",
    "./poteto-mode": "./dist/poteto-mode.mjs",
    "./preset": "./dist/preset.mjs",
    "./preset-copy": "./dist/preset-copy.mjs",
    "./readonly": "./dist/readonly.mjs",
    "./role-catalog": "./dist/role-catalog.mjs",
    "./role-config": "./dist/role-config.mjs",
    "./role-editor": "./dist/role-editor.mjs",
    "./role-file": "./dist/role-file.mjs",
    "./role-manifest": "./dist/role-manifest.mjs",
    "./role-remote": "./dist/role-remote.mjs",
    "./role-service": "./dist/role-service.mjs",
    "./role-wire": "./dist/role-wire.mjs",
    "./route": "./dist/route.mjs",
    "./skill": "./dist/skill.mjs",
    "./subagent": "./dist/subagent.mjs",
    "./wire-error": "./dist/wire-error.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "prepare": "vp config && skills experimental_sync -y -a universal --copy && skills add ./skills/authored -y -a universal",
    "ci": "vp check && vp run typecheck && vp run playground:typecheck && vp test && vp run generate:check && vp run compatibility:check && vp run build",
    "prerelease": "vp run ci",
    "release": "bumpp",
    "prepublishOnly": "vp run ci"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:runtime"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:runtime",
    "@deepseek-ai/cordis-plugin-loader": "catalog:runtime",
    "@deepseek-ai/dsh-agent": "catalog:types",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:types",
    "@deepseek-ai/dsh-api-gateway": "catalog:types",
    "@deepseek-ai/dsh-api-remotes": "catalog:types",
    "@deepseek-ai/dsh-client-locale": "catalog:types",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:types",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:types",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:types",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:types",
    "@deepseek-ai/dsh-llm": "catalog:types",
    "@deepseek-ai/dsh-plugin-manager": "catalog:types",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:runtime",
    "@deepseek-ai/dsh-settings": "catalog:types",
    "@deepseek-ai/dsh-skill": "catalog:types",
    "@deepseek-ai/dsh-subagent": "catalog:types",
    "@deepseek-ai/dsh-tools": "catalog:types",
    "@deepseek-ai/dsh-typert-protocol": "catalog:runtime",
    "@deepseek-ai/dsh-typert-registry": "catalog:types",
    "@deepseek-ai/dsh-working-directory": "catalog:types",
    "@types/node": "catalog:types",
    "@types/react": "catalog:ui",
    "@types/react-dom": "catalog:ui",
    "agent-browser": "catalog:browser",
    "bumpp": "catalog:cli",
    "happy-dom": "catalog:testing",
    "react": "catalog:ui",
    "react-dom": "catalog:ui",
    "skills": "catalog:agentic",
    "typescript": "catalog:cli",
    "vite-plus": "catalog:cli"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:runtime",
    "@deepseek-ai/cordis-plugin-loader": "catalog:runtime",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:runtime",
    "@deepseek-ai/dsh-typert-protocol": "catalog:runtime"
  },
  "icon": "./assets/logo.png",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=24.21.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "skills": [
    {
      "source": "mattpocock/skills",
      "skills": [
        "writing-for-agents",
        "retro"
      ],
      "ref": "59db609eb1e18aaf59b63284d0e52255aff0c63c"
    },
    {
      "source": "npm:agent-browser",
      "skills": [
        "agent-browser"
      ]
    }
  ]
}
