{
  "name": "dsh-pstack",
  "version": "0.1.0",
  "description": "pstack for DeepSeek Harness: rigorous agent workflows ported from cursor/plugins.",
  "keywords": [
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "poteto-mode",
    "pstack",
    "workflow"
  ],
  "homepage": "https://github.com/l246804/dsh-pstack",
  "bugs": {
    "url": "https://github.com/l246804/dsh-pstack/issues"
  },
  "license": "MIT",
  "author": {
    "name": "leiwang",
    "email": "leiwang2000@foxmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/l246804/dsh-pstack"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./subagent": {
      "types": "./dist/subagent.d.mts",
      "default": "./dist/subagent.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "sync": "node scripts/sync-upstream.ts",
    "sync:check": "node scripts/check-rewrites.ts --check && node scripts/sync-upstream.ts --check && node scripts/report-coverage.ts --check",
    "sync:report": "node scripts/report-coverage.ts",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "release": "bumpp",
    "prepare": "vp pack",
    "prepublishOnly": "node scripts/check-rewrites.ts --check && node scripts/sync-upstream.ts --check && node scripts/report-coverage.ts --check && vp pack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-tool-worktree": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-worktree": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
