{
  "name": "dsh-pstack",
  "version": "0.2.0-beta.2",
  "description": "pstack for DeepSeek Harness: rigorous agent workflows ported from cursor/plugins.",
  "keywords": [
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "poteto-mode",
    "pstack",
    "workflow"
  ],
  "homepage": "https://github.com/l246804/dsh-pstack#readme",
  "bugs": {
    "url": "https://github.com/l246804/dsh-pstack/issues"
  },
  "license": "MIT",
  "author": {
    "name": "leiwang",
    "email": "leiwang2000@foxmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/dsh-pstack.git"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./models": "./dist/models.mjs",
    "./script": "./dist/script.mjs",
    "./skill": "./dist/skill.mjs",
    "./subagent": "./dist/subagent.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "prepare": "skills experimental_sync -y -a universal",
    "prerelease": "vp run -r test",
    "release": "bumpp",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "catalog:types",
    "@deepseek-ai/dsh-jobs": "catalog:types",
    "@deepseek-ai/dsh-llm": "catalog:types",
    "@deepseek-ai/dsh-session": "catalog:types",
    "@deepseek-ai/dsh-skill": "catalog:types",
    "@deepseek-ai/dsh-subagent": "catalog:types",
    "@deepseek-ai/dsh-system-prompt": "catalog:types",
    "@deepseek-ai/dsh-tools": "catalog:types",
    "@deepseek-ai/dsh-working-directory": "catalog:types",
    "commander": "catalog:inlined"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "js-yaml": "catalog:testing",
    "skills": "catalog:agentic",
    "typescript": "catalog:cli",
    "vite-plus": "catalog:cli"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "icon": "./assets/logo.png",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "dsh": "0.2.2-alpha.2",
    "node": ">=24.21.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "skills": [
    {
      "source": "mattpocock/skills",
      "skills": [
        "writing-for-agents",
        "retro"
      ],
      "ref": "59db609eb1e18aaf59b63284d0e52255aff0c63c"
    }
  ]
}
