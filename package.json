{
  "name": "dsh-pstack",
  "version": "0.2.0-beta.1",
  "description": "pstack for DeepSeek Harness: rigorous agent workflows ported from cursor/plugins.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l246804/dsh-pstack.git"
  },
  "homepage": "https://github.com/l246804/dsh-pstack#readme",
  "bugs": {
    "url": "https://github.com/l246804/dsh-pstack/issues"
  },
  "keywords": [
    "agent-skills",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "poteto-mode",
    "pstack",
    "workflow"
  ],
  "author": {
    "name": "leiwang",
    "email": "leiwang2000@foxmail.com"
  },
  "license": "MIT",
  "type": "module",
  "icon": "./static/icon.png",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./subagent": {
      "types": "./dist/subagent.d.mts",
      "default": "./dist/subagent.mjs"
    },
    "./history": {
      "types": "./dist/history.d.mts",
      "default": "./dist/history.mjs"
    },
    "./script": {
      "types": "./dist/script.d.mts",
      "default": "./dist/script.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./static/icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "static"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "commander": "14.0.0",
    "js-yaml": "^4.3.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.3"
  }
}
